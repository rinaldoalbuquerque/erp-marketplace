// Prisma schema. Database changes ONLY through migrations (`npm run db:migrate`).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  operator

  @@map("membership_role")
}

/// Tenant. Every business table has an organization_id pointing here.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  products            Product[]
  skus                Sku[]
  stockMovements      StockMovement[]
  marketplaceAccounts MarketplaceAccount[]
  listings            Listing[]
  listingVariations   ListingVariation[]
  skuListingMappings  SkuListingMapping[]
  syncJobs            SyncJob[]
  listingEdits        ListingEdit[]

  @@map("organizations")
}

/// User profile. id is the Supabase Auth user id (auth.users.id).
model Profile {
  id              String    @id @db.Uuid
  fullName        String    @map("full_name")
  /// E.164 format, e.g. +5511999999999
  phone           String?
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  stockMovements      StockMovement[]
  marketplaceAccounts MarketplaceAccount[]
  skuListingMappings  SkuListingMapping[]
  syncJobs            SyncJob[]
  listingEdits        ListingEdit[]

  @@map("profiles")
}

/// Which users belong to which organization, and with which role.
model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// What happened to the stock. Signed quantity lives in StockMovement.quantity.
enum StockMovementType {
  /// Manual entry (purchase, production...)
  manual_in
  /// Manual exit (loss, damage, internal use...)
  manual_out
  /// Physical count: stock set to the counted amount
  count
  /// Marketplace sale (Phase 3)
  sale
  /// Customer return (Phase 3)
  sale_return

  @@map("stock_movement_type")
}

/// Sellable item grouping its variations (SKUs). Archived, never deleted.
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  brand          String?
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skus         Sku[]

  /// Target of composite foreign keys (a SKU can only point to a product of its own organization).
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@map("products")
}

/// A sellable variation. Stock belongs to the SKU (CLAUDE.md: "Estoque é do ERP, por SKU").
model Sku {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// Stored uppercase and trimmed; unique per organization.
  code           String
  /// EAN/GTIN (8, 12, 13 or 14 digits, check digit validated)
  ean            String?
  /// Variation attributes: [{ "name": "Cor", "value": "Azul" }, ...]
  variation      Json?

  // Fiscal (NF-e)
  /// 8 digits
  ncm         String?
  /// 7 digits
  cest        String?
  /// NF-e origin code 0-8
  origin      Int?
  unit        String  @default("UN")
  /// 4 digits, e.g. 5102
  defaultCfop String? @map("default_cfop")

  // Shipping (optional)
  weightGrams Int? @map("weight_grams")
  heightCm    Int? @map("height_cm")
  widthCm     Int? @map("width_cm")
  lengthCm    Int? @map("length_cm")

  /// Where it is in the warehouse, e.g. "Prateleira A3"
  location  String?
  /// Unit cost in cents (visible only with "financial.view")
  costCents Int?    @map("cost_cents")

  /// Current balance. Changed ONLY together with a StockMovement (src/server/stock).
  stockOnHand Int @default(0) @map("stock_on_hand")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: the product must belong to the same organization (enforced by the database).
  // NoAction (checked at end of statement) so deleting an organization cascades cleanly.
  product         Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: NoAction)
  stockMovements  StockMovement[]
  listingMappings SkuListingMapping[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, ean])
  @@index([productId])
  @@map("skus")
}

/// Stock history. Append-only: never updated or deleted.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  skuId          String            @map("sku_id") @db.Uuid
  type           StockMovementType
  /// Signed change: +10 entry, -1 sale
  quantity       Int
  /// SKU balance right after this movement
  balanceAfter   Int               @map("balance_after")
  reason         String?
  /// Prevents applying the same event twice (e.g. a marketplace sale notification)
  idempotencyKey String?           @map("idempotency_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: the SKU must belong to the same organization.
  sku          Sku          @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)
  createdBy    Profile?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([skuId, createdAt])
  @@map("stock_movements")
}

enum Marketplace {
  mercadolivre

  @@map("marketplace")
}

/// Listing format used by a marketplace account (Mercado Livre: traditional vs User Products).
enum ListingModel {
  traditional
  user_products
  unknown

  @@map("listing_model")
}

enum MarketplaceAccountStatus {
  active
  /// The marketplace invalidated the authorization: the owner must reconnect.
  needs_reauth
  /// Disconnected by the user (tokens erased; row kept for history).
  disconnected

  @@map("marketplace_account_status")
}

/// A seller account connected to the ERP. Unlimited per organization, each one
/// with its own credentials and sync state (CLAUDE.md).
model MarketplaceAccount {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  marketplace    Marketplace
  /// Seller id in the marketplace (Mercado Livre user_id), stored as text.
  externalUserId String                   @map("external_user_id")
  nickname       String
  siteId         String?                  @map("site_id")
  listingModel   ListingModel             @default(unknown) @map("listing_model")
  status         MarketplaceAccountStatus @default(active)
  /// The ERP may change listings of this account (off by default; the owner turns it on).
  allowWrites    Boolean                  @default(false) @map("allow_writes")

  /// AES-256-GCM encrypted (src/server/crypto). Never logged or shown.
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  scopes                String?
  lastTokenRefreshAt    DateTime? @map("last_token_refresh_at") @db.Timestamptz(6)

  /// Last successful data sync (Phase 2A)
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz(6)
  /// Last error shown to the owner (no secrets)
  lastError     String?   @map("last_error")
  connectedById String?   @map("connected_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  Profile?     @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  listings     Listing[]
  syncJobs     SyncJob[]

  /// One marketplace account belongs to a single organization (SaaS-safe).
  @@unique([marketplace, externalUserId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("marketplace_accounts")
}

/// A listing imported from a marketplace account (Phase 2A: read-only copy).
/// Screens read from here, never from the marketplace API (CLAUDE.md).
model Listing {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  marketplaceAccountId String       @map("marketplace_account_id") @db.Uuid
  marketplace          Marketplace
  /// Marketplace id, e.g. MLB1234567890
  externalId           String       @map("external_id")
  title                String
  /// Raw marketplace status (ML: active, paused, closed, under_review...)
  status               String
  subStatus            String[]     @default([]) @map("sub_status")
  priceCents           Int?         @map("price_cents")
  currency             String?
  availableQuantity    Int?         @map("available_quantity")
  soldQuantity         Int?         @map("sold_quantity")
  permalink            String?
  thumbnailUrl         String?      @map("thumbnail_url")
  categoryId           String?      @map("category_id")
  listingTypeId        String?      @map("listing_type_id")
  condition            String?
  listingModel         ListingModel @default(unknown) @map("listing_model")
  /// ML User Products
  userProductId        String?      @map("user_product_id")
  familyId             String?      @map("family_id")
  familyName           String?      @map("family_name")
  /// Seller SKU in the marketplace (ML: seller_custom_field or SELLER_SKU attribute)
  sellerSku            String?      @map("seller_sku")
  externalUpdatedAt    DateTime?    @map("external_updated_at") @db.Timestamptz(6)
  /// Full marketplace payload, base for the canonical model and editing (2B).
  raw                  Json
  syncedAt             DateTime     @map("synced_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount  @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  variations   ListingVariation[]
  mappings     SkuListingMapping[]
  edits        ListingEdit[]

  @@unique([marketplaceAccountId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, marketplaceAccountId])
  @@index([organizationId, familyId])
  @@map("listings")
}

/// Variation of a traditional listing (ML "variations" array).
model ListingVariation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  listingId         String   @map("listing_id") @db.Uuid
  /// Marketplace variation id (as text)
  externalId        String   @map("external_id")
  /// [{ "name": "Cor", "value": "Azul" }, ...]
  attributes        Json
  priceCents        Int?     @map("price_cents")
  availableQuantity Int?     @map("available_quantity")
  soldQuantity      Int?     @map("sold_quantity")
  sellerSku         String?  @map("seller_sku")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing             @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  mappings     SkuListingMapping[]

  @@unique([listingId, externalId])
  @@unique([organizationId, id])
  @@map("listing_variations")
}

/// Links an ERP SKU to a listing (or one of its variations). Stock flows from the SKU.
model SkuListingMapping {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  skuId              String   @map("sku_id") @db.Uuid
  listingId          String   @map("listing_id") @db.Uuid
  listingVariationId String?  @map("listing_variation_id") @db.Uuid
  /// Variation id, or "" when the whole listing is linked. Makes "one SKU per
  /// listing/variation" enforceable by a unique index (NULLs would not collide).
  variationKey       String   @default("") @map("variation_key")
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku          Sku               @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)
  listing      Listing           @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  variation    ListingVariation? @relation(fields: [organizationId, listingVariationId], references: [organizationId, id], onDelete: Cascade)
  createdBy    Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([listingId, variationKey])
  @@index([organizationId, skuId])
  @@map("sku_listing_mappings")
}

enum SyncJobType {
  import_listings

  @@map("sync_job_type")
}

enum SyncJobStatus {
  queued
  running
  /// Stopped at the time budget; resumes from pendingIds.
  paused
  completed
  failed

  @@map("sync_job_status")
}

/// Background job with progress, report and resume (CLAUDE.md: batch operations).
model SyncJob {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  marketplaceAccountId String        @map("marketplace_account_id") @db.Uuid
  type                 SyncJobType
  status               SyncJobStatus @default(queued)
  total                Int?
  processed            Int           @default(0)
  createdCount         Int           @default(0) @map("created_count")
  updatedCount         Int           @default(0) @map("updated_count")
  failedCount          Int           @default(0) @map("failed_count")
  /// External ids still to process (resume point)
  pendingIds           Json?         @map("pending_ids")
  /// First errors: [{ "id": "MLB...", "message": "..." }]
  errors               Json          @default("[]")
  lastError            String?       @map("last_error")
  startedById          String?       @map("started_by_id") @db.Uuid
  startedAt            DateTime?     @map("started_at") @db.Timestamptz(6)
  heartbeatAt          DateTime?     @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt           DateTime?     @map("finished_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  startedBy    Profile?           @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([organizationId, marketplaceAccountId, createdAt])
  @@map("sync_jobs")
}

/// Category technical sheet (attributes) cached from the marketplace for 24h.
/// Public marketplace metadata, the same for every organization: no
/// organization_id; read only by server code (src/server/listings/categories.ts).
model MarketplaceCategory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplace Marketplace
  categoryId  String      @map("category_id")
  /// Neutral attribute definitions (src/domain/listings/attributes.ts)
  attributes  Json
  fetchedAt   DateTime    @map("fetched_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([marketplace, categoryId])
  @@map("marketplace_categories")
}

enum ListingEditStatus {
  success
  /// Saved, but the marketplace ignored part of it (e.g. price under automation)
  partial
  failed

  @@map("listing_edit_status")
}

/// History of every change the ERP sent to a marketplace listing.
model ListingEdit {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  listingId      String            @map("listing_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  /// [{ "field": "price", "before": ..., "after": ... }]
  changes        Json
  status         ListingEditStatus
  /// Message shown to the user (marketplace errors/warnings translated)
  message        String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing      @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  user         Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, listingId, createdAt])
  @@map("listing_edits")
}
