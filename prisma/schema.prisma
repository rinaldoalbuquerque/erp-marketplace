// Prisma schema. Database changes ONLY through migrations (`npm run db:migrate`).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  operator

  @@map("membership_role")
}

/// Tenant. Every business table has an organization_id pointing here.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  products            Product[]
  skus                Sku[]
  stockMovements      StockMovement[]
  marketplaceAccounts MarketplaceAccount[]
  listings            Listing[]
  listingVariations   ListingVariation[]
  skuListingMappings  SkuListingMapping[]
  syncJobs            SyncJob[]
  listingEdits        ListingEdit[]
  stockPushes         StockPush[]
  orders              Order[]
  orderItems          OrderItem[]
  invoices            Invoice[]
  listingDrafts       ListingDraft[]

  @@map("organizations")
}

/// User profile. id is the Supabase Auth user id (auth.users.id).
model Profile {
  id              String    @id @db.Uuid
  fullName        String    @map("full_name")
  /// E.164 format, e.g. +5511999999999
  phone           String?
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  stockMovements      StockMovement[]
  marketplaceAccounts MarketplaceAccount[]
  skuListingMappings  SkuListingMapping[]
  syncJobs            SyncJob[]
  listingEdits        ListingEdit[]
  invoices            Invoice[]
  listingDrafts       ListingDraft[]

  @@map("profiles")
}

/// Which users belong to which organization, and with which role.
model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// What happened to the stock. Signed quantity lives in StockMovement.quantity.
enum StockMovementType {
  /// Manual entry (purchase, production...)
  manual_in
  /// Manual exit (loss, damage, internal use...)
  manual_out
  /// Physical count: stock set to the counted amount
  count
  /// Marketplace sale (Phase 3)
  sale
  /// Customer return (Phase 3)
  sale_return

  @@map("stock_movement_type")
}

/// Sellable item grouping its variations (SKUs). Archived, never deleted.
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  brand          String?
  description    String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skus         Sku[]

  /// Target of composite foreign keys (a SKU can only point to a product of its own organization).
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@map("products")
}

/// A sellable variation. Stock belongs to the SKU (CLAUDE.md: "Estoque é do ERP, por SKU").
model Sku {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// Stored uppercase and trimmed; unique per organization.
  code           String
  /// EAN/GTIN (8, 12, 13 or 14 digits, check digit validated)
  ean            String?
  /// Variation attributes: [{ "name": "Cor", "value": "Azul" }, ...]
  variation      Json?

  // Fiscal (NF-e)
  /// 8 digits
  ncm         String?
  /// 7 digits
  cest        String?
  /// NF-e origin code 0-8
  origin      Int?
  unit        String  @default("UN")
  /// 4 digits, e.g. 5102
  defaultCfop String? @map("default_cfop")
  /// Simples Nacional: CSOSN, 3 digits (e.g. 102, 500)
  csosn       String?

  // Shipping (optional)
  weightGrams Int? @map("weight_grams")
  heightCm    Int? @map("height_cm")
  widthCm     Int? @map("width_cm")
  lengthCm    Int? @map("length_cm")

  /// Where it is in the warehouse, e.g. "Prateleira A3"
  location  String?
  /// Unit cost in cents (visible only with "financial.view")
  costCents Int?    @map("cost_cents")

  /// Current balance. Changed ONLY together with a StockMovement (src/server/stock).
  stockOnHand Int @default(0) @map("stock_on_hand")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  listingDrafts   ListingDraft[]
  // Composite key: the product must belong to the same organization (enforced by the database).
  // NoAction (checked at end of statement) so deleting an organization cascades cleanly.
  product         Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: NoAction)
  stockMovements  StockMovement[]
  listingMappings SkuListingMapping[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, ean])
  @@index([productId])
  @@map("skus")
}

/// Stock history. Append-only: never updated or deleted.
model StockMovement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  skuId          String            @map("sku_id") @db.Uuid
  type           StockMovementType
  /// Signed change: +10 entry, -1 sale
  quantity       Int
  /// SKU balance right after this movement
  balanceAfter   Int               @map("balance_after")
  reason         String?
  /// Prevents applying the same event twice (e.g. a marketplace sale notification)
  idempotencyKey String?           @map("idempotency_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: the SKU must belong to the same organization.
  sku          Sku          @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)
  createdBy    Profile?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([skuId, createdAt])
  @@map("stock_movements")
}

enum Marketplace {
  mercadolivre

  @@map("marketplace")
}

/// Listing format used by a marketplace account (Mercado Livre: traditional vs User Products).
enum ListingModel {
  traditional
  user_products
  unknown

  @@map("listing_model")
}

enum MarketplaceAccountStatus {
  active
  /// The marketplace invalidated the authorization: the owner must reconnect.
  needs_reauth
  /// Disconnected by the user (tokens erased; row kept for history).
  disconnected

  @@map("marketplace_account_status")
}

/// A seller account connected to the ERP. Unlimited per organization, each one
/// with its own credentials and sync state (CLAUDE.md).
model MarketplaceAccount {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  marketplace       Marketplace
  /// Seller id in the marketplace (Mercado Livre user_id), stored as text.
  externalUserId    String                   @map("external_user_id")
  nickname          String
  siteId            String?                  @map("site_id")
  listingModel      ListingModel             @default(unknown) @map("listing_model")
  status            MarketplaceAccountStatus @default(active)
  /// The ERP may change listings of this account (off by default; the owner turns it on).
  allowWrites       Boolean                  @default(false) @map("allow_writes")
  /// Send ERP stock to the linked listings (off by default; enabled after a preview).
  stockSyncEnabled  Boolean                  @default(false) @map("stock_sync_enabled")
  /// Seller uses multi-origin stock (ML tag warehouse_management): other stock endpoint.
  multiWarehouse    Boolean                  @default(false) @map("multi_warehouse")
  /// Sales of this account lower ERP stock (off by default).
  orderStockEnabled Boolean                  @default(false) @map("order_stock_enabled")
  /// Only orders confirmed after this moment move stock (older sales were already counted).
  orderStockSince   DateTime?                @map("order_stock_since") @db.Timestamptz(6)
  /// Orders changed up to this moment were already fetched (catch-up search cursor).
  ordersSyncedAt    DateTime?                @map("orders_synced_at") @db.Timestamptz(6)

  /// AES-256-GCM encrypted (src/server/crypto). Never logged or shown.
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  scopes                String?
  lastTokenRefreshAt    DateTime? @map("last_token_refresh_at") @db.Timestamptz(6)

  /// Last successful data sync (Phase 2A)
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz(6)
  /// Last error shown to the owner (no secrets)
  lastError     String?   @map("last_error")
  connectedById String?   @map("connected_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy   Profile?       @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  listings      Listing[]
  syncJobs      SyncJob[]
  orders        Order[]
  invoices      Invoice[]
  listingDrafts ListingDraft[]

  /// One marketplace account belongs to a single organization (SaaS-safe).
  @@unique([marketplace, externalUserId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("marketplace_accounts")
}

/// A listing imported from a marketplace account (Phase 2A: read-only copy).
/// Screens read from here, never from the marketplace API (CLAUDE.md).
model Listing {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  marketplaceAccountId String       @map("marketplace_account_id") @db.Uuid
  marketplace          Marketplace
  /// Marketplace id, e.g. MLB1234567890
  externalId           String       @map("external_id")
  title                String
  /// Raw marketplace status (ML: active, paused, closed, under_review...)
  status               String
  subStatus            String[]     @default([]) @map("sub_status")
  priceCents           Int?         @map("price_cents")
  currency             String?
  availableQuantity    Int?         @map("available_quantity")
  soldQuantity         Int?         @map("sold_quantity")
  permalink            String?
  thumbnailUrl         String?      @map("thumbnail_url")
  categoryId           String?      @map("category_id")
  listingTypeId        String?      @map("listing_type_id")
  condition            String?
  listingModel         ListingModel @default(unknown) @map("listing_model")
  /// ML User Products
  userProductId        String?      @map("user_product_id")
  familyId             String?      @map("family_id")
  familyName           String?      @map("family_name")
  /// Seller SKU in the marketplace (ML: seller_custom_field or SELLER_SKU attribute)
  sellerSku            String?      @map("seller_sku")
  /// Shipping logistic (ML shipping.logistic_type), e.g. fulfillment = Full
  logisticType         String?      @map("logistic_type")
  externalUpdatedAt    DateTime?    @map("external_updated_at") @db.Timestamptz(6)
  /// Full marketplace payload, base for the canonical model and editing (2B).
  raw                  Json
  syncedAt             DateTime     @map("synced_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount  @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  variations   ListingVariation[]
  mappings     SkuListingMapping[]
  edits        ListingEdit[]
  stockPushes  StockPush[]
  orderItems   OrderItem[]
  drafts       ListingDraft[]

  @@unique([marketplaceAccountId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, marketplaceAccountId])
  @@index([organizationId, familyId])
  @@map("listings")
}

/// Variation of a traditional listing (ML "variations" array).
model ListingVariation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  listingId         String   @map("listing_id") @db.Uuid
  /// Marketplace variation id (as text)
  externalId        String   @map("external_id")
  /// [{ "name": "Cor", "value": "Azul" }, ...]
  attributes        Json
  priceCents        Int?     @map("price_cents")
  availableQuantity Int?     @map("available_quantity")
  soldQuantity      Int?     @map("sold_quantity")
  sellerSku         String?  @map("seller_sku")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing             @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  mappings     SkuListingMapping[]

  @@unique([listingId, externalId])
  @@unique([organizationId, id])
  @@map("listing_variations")
}

/// Links an ERP SKU to a listing (or one of its variations). Stock flows from the SKU.
model SkuListingMapping {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  skuId              String   @map("sku_id") @db.Uuid
  listingId          String   @map("listing_id") @db.Uuid
  listingVariationId String?  @map("listing_variation_id") @db.Uuid
  /// Variation id, or "" when the whole listing is linked. Makes "one SKU per
  /// listing/variation" enforceable by a unique index (NULLs would not collide).
  variationKey       String   @default("") @map("variation_key")
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku          Sku               @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)
  listing      Listing           @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  variation    ListingVariation? @relation(fields: [organizationId, listingVariationId], references: [organizationId, id], onDelete: Cascade)
  createdBy    Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([listingId, variationKey])
  @@index([organizationId, skuId])
  @@map("sku_listing_mappings")
}

enum SyncJobType {
  import_listings
  /// Copy many listings into drafts of an account (2D)
  replicate_listings
  /// Publish many drafts (2D)
  publish_drafts
  /// Change price or status of many listings (bulk edit)
  bulk_edit_listings

  @@map("sync_job_type")
}

enum SyncJobStatus {
  queued
  running
  /// Stopped at the time budget; resumes from pendingIds.
  paused
  completed
  failed

  @@map("sync_job_status")
}

/// Background job with progress, report and resume (CLAUDE.md: batch operations).
model SyncJob {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  marketplaceAccountId String        @map("marketplace_account_id") @db.Uuid
  type                 SyncJobType
  status               SyncJobStatus @default(queued)
  total                Int?
  processed            Int           @default(0)
  createdCount         Int           @default(0) @map("created_count")
  updatedCount         Int           @default(0) @map("updated_count")
  failedCount          Int           @default(0) @map("failed_count")
  /// External ids still to process (resume point)
  pendingIds           Json?         @map("pending_ids")
  /// Job options, e.g. replicate: { "pricePercent": 10, "roundTo90": true, "listingTypeId": "gold_pro" }
  params               Json?
  /// First errors: [{ "id": "MLB...", "message": "..." }]
  errors               Json          @default("[]")
  lastError            String?       @map("last_error")
  startedById          String?       @map("started_by_id") @db.Uuid
  startedAt            DateTime?     @map("started_at") @db.Timestamptz(6)
  heartbeatAt          DateTime?     @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt           DateTime?     @map("finished_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  startedBy    Profile?           @relation(fields: [startedById], references: [id], onDelete: SetNull)
  drafts       ListingDraft[]

  @@unique([organizationId, id])
  @@index([organizationId, marketplaceAccountId, createdAt])
  @@map("sync_jobs")
}

/// Category technical sheet (attributes) cached from the marketplace for 24h.
/// Public marketplace metadata, the same for every organization: no
/// organization_id; read only by server code (src/server/listings/categories.ts).
model MarketplaceCategory {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplace Marketplace
  categoryId  String      @map("category_id")
  /// Neutral attribute definitions (src/domain/listings/attributes.ts)
  attributes  Json
  fetchedAt   DateTime    @map("fetched_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([marketplace, categoryId])
  @@map("marketplace_categories")
}

enum ListingEditStatus {
  success
  /// Saved, but the marketplace ignored part of it (e.g. price under automation)
  partial
  failed

  @@map("listing_edit_status")
}

/// History of every change the ERP sent to a marketplace listing.
model ListingEdit {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  listingId      String            @map("listing_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  /// [{ "field": "price", "before": ..., "after": ... }]
  changes        Json
  status         ListingEditStatus
  /// Message shown to the user (marketplace errors/warnings translated)
  message        String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing      @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)
  user         Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, listingId, createdAt])
  @@map("listing_edits")
}

enum StockPushStatus {
  pending
  sent
  /// Not sent on purpose (Full, unsupported...): see skipReason
  skipped
  /// Gave up after retries or refused by the marketplace: see lastError
  failed

  @@map("stock_push_status")
}

/// Outbox of stock updates to marketplace listings: at most one row per
/// listing/variation, always holding the latest desired quantity.
model StockPush {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  listingId       String          @map("listing_id") @db.Uuid
  /// Variation id, or "" for the whole listing (same idea as sku_listing_mappings)
  variationKey    String          @default("") @map("variation_key")
  desiredQuantity Int             @map("desired_quantity")
  status          StockPushStatus @default(pending)
  attempts        Int             @default(0)
  nextAttemptAt   DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// Set by the round processing the row; a new enqueue clears it so a stale
  /// result never overwrites a newer quantity.
  claimToken      String?         @map("claim_token") @db.Uuid
  claimedUntil    DateTime?       @map("claimed_until") @db.Timestamptz(6)
  lastError       String?         @map("last_error")
  skipReason      String?         @map("skip_reason")
  sentQuantity    Int?            @map("sent_quantity")
  sentAt          DateTime?       @map("sent_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing      @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: Cascade)

  @@unique([listingId, variationKey])
  @@index([organizationId, status, nextAttemptAt])
  @@map("stock_pushes")
}

enum NotificationStatus {
  pending
  done
  /// Not for us (unknown account, topic we do not use)
  ignored
  failed

  @@map("notification_status")
}

/// Inbox of marketplace notifications (internal, no organization: the account is
/// resolved when processing). One row per resource: a repeated notification sets
/// it back to pending and bumps `version`, so a round that read an older version
/// never marks the newer one as done.
model MarketplaceNotification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplace    Marketplace
  topic          String
  /// e.g. /orders/2000003508897196 (only says WHAT to fetch; never trusted as data)
  resource       String
  externalUserId String             @map("external_user_id")
  status         NotificationStatus @default(pending)
  version        Int                @default(1)
  tries          Int                @default(0)
  nextAttemptAt  DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  claimedUntil   DateTime?          @map("claimed_until") @db.Timestamptz(6)
  lastError      String?            @map("last_error")
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@unique([marketplace, topic, resource])
  @@index([status, nextAttemptAt])
  @@map("marketplace_notifications")
}

/// Marketplace sale (ML order). Saved again on every change (idempotent by external id).
model Order {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  marketplaceAccountId String      @map("marketplace_account_id") @db.Uuid
  marketplace          Marketplace
  externalId           String      @map("external_id")
  /// Cart: orders bought together share it (ML pack_id)
  packId               String?     @map("pack_id")
  /// Raw marketplace status (ML: paid, cancelled, partially_refunded...)
  status               String
  tags                 String[]    @default([])
  totalCents           Int?        @map("total_cents")
  currency             String?
  buyerNickname        String?     @map("buyer_nickname")
  shippingId           String?     @map("shipping_id")
  /// From the sold listing (fulfillment = Full: the stock is in the marketplace warehouse)
  logisticType         String?     @map("logistic_type")
  dateCreated          DateTime    @map("date_created") @db.Timestamptz(6)
  /// When the sale was confirmed (ML discounts its stock here)
  dateClosed           DateTime?   @map("date_closed") @db.Timestamptz(6)
  externalUpdatedAt    DateTime?   @map("external_updated_at") @db.Timestamptz(6)

  // Shipment (ML /shipments/{shippingId}), copied onto every order that shares it
  // (cart orders share one shipment), so the screen filters by stage directly.
  /// Where the order is in the shipping flow (computed from the shipment)
  stage             OrderStage @default(pending)
  shipmentStatus    String?    @map("shipment_status")
  shipmentSubstatus String?    @map("shipment_substatus")
  /// ML logistic.mode, e.g. me2 (labels only exist for me2)
  shipmentMode      String?    @map("shipment_mode")
  trackingNumber    String?    @map("tracking_number")
  /// Label can only be printed from this moment (substatus buffered)
  labelAvailableAt  DateTime?  @map("label_available_at") @db.Timestamptz(6)
  /// Dispatch deadline (ML /shipments/{id}/sla expected_date)
  dispatchBy        DateTime?  @map("dispatch_by") @db.Timestamptz(6)
  /// on_time, delayed, early...
  slaStatus         String?    @map("sla_status")
  shipmentSyncedAt  DateTime?  @map("shipment_synced_at") @db.Timestamptz(6)

  /// Sale invoice (NF-e) of this order; cart orders share one invoice
  invoiceId        String?   @map("invoice_id") @db.Uuid
  /// Last time the invoice of this order was looked up at the marketplace
  invoiceCheckedAt DateTime? @map("invoice_checked_at") @db.Timestamptz(6)

  raw       Json
  syncedAt  DateTime @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  items        OrderItem[]
  invoice      Invoice?           @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: NoAction)

  @@unique([marketplaceAccountId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, dateCreated])
  @@index([organizationId, stage])
  @@index([marketplaceAccountId, shippingId])
  @@map("orders")
}

/// Shipping stage shown as tabs on the Orders screen.
enum OrderStage {
  /// Not paid yet, shipment not created or being prepared
  pending
  /// Waiting for the invoice (NF): the label is released after it
  invoice_pending
  ready_to_print
  /// Label printed: waiting for pickup / drop-off
  printed
  shipped
  delivered
  cancelled
  /// Full: the marketplace ships it (no label)
  fulfillment
  /// No marketplace shipping (to be agreed, pickup...)
  other

  @@map("order_stage")
}

enum OrderItemStockStatus {
  /// Not confirmed yet (e.g. payment pending)
  waiting
  deducted
  /// Cancelled after the deduction: stock given back
  restored
  /// Full, sale before the switch was on, or switch off
  not_applicable
  /// Sold listing is not linked to an ERP SKU
  missing_sku

  @@map("order_item_stock_status")
}

model OrderItem {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  /// Marketplace listing id, e.g. MLB123
  externalItemId String               @map("external_item_id")
  /// Variation id, or "" (same idea as sku_listing_mappings)
  variationKey   String               @default("") @map("variation_key")
  title          String
  quantity       Int
  unitPriceCents Int?                 @map("unit_price_cents")
  saleFeeCents   Int?                 @map("sale_fee_cents")
  sellerSku      String?              @map("seller_sku")
  /// Local listing, when imported
  listingId      String?              @map("listing_id") @db.Uuid
  /// SKU whose stock was moved (kept even if the link changes later)
  skuId          String?              @map("sku_id") @db.Uuid
  stockStatus    OrderItemStockStatus @default(waiting) @map("stock_status")
  stockNote      String?              @map("stock_note")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: NoAction)
  sku          Sku?         @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)

  @@unique([orderId, externalItemId, variationKey])
  @@index([organizationId, skuId])
  @@map("order_items")
}

/// Who issued an invoice (CLAUDE.md: FiscalProvider). The rest of the ERP only
/// sees the `invoices` table, whoever issued it.
enum InvoiceProvider {
  /// Mercado Livre's own issuer (Faturador), via API or the seller panel
  mercadolivre
  /// XML issued elsewhere and sent to the marketplace (plan B, Phase 4B)
  xml_import

  @@map("invoice_provider")
}

/// Sale invoice (NF-e). One per cart (all orders of a pack share it).
model Invoice {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  marketplaceAccountId String          @map("marketplace_account_id") @db.Uuid
  provider             InvoiceProvider
  /// Invoice id at the provider (ML invoice id); null while requesting
  externalId           String?         @map("external_id")
  /// "requesting" while the ERP asks for it, "error" when refused; otherwise the
  /// provider status (ML: authorized, ...)
  status               String
  number               Int?
  series               String?
  /// 44-digit access key
  accessKey            String?         @map("access_key")
  amountCents          Int?            @map("amount_cents")
  issuedAt             DateTime?       @map("issued_at") @db.Timestamptz(6)
  /// Provider paths to download the DANFE (PDF) and the XML
  danfePath            String?         @map("danfe_path")
  xmlPath              String?         @map("xml_path")
  errorCode            String?         @map("error_code")
  errorMessage         String?         @map("error_message")
  /// Pack id, or the order id when the sale is not a cart: one invoice request at a time per key
  packKey              String          @map("pack_key")
  requestedById        String?         @map("requested_by_id") @db.Uuid
  raw                  Json?
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  requestedBy  Profile?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  orders       Order[]

  @@unique([marketplaceAccountId, externalId])
  @@unique([organizationId, id])
  @@index([marketplaceAccountId, packKey])
  @@map("invoices")
}

enum ListingDraftStatus {
  draft
  /// The marketplace validated it (POST /items/validate) with no errors
  validated
  /// Being published right now (claim: only one publish per draft)
  publishing
  published
  /// The last validate/publish attempt was refused (see lastErrors)
  failed

  @@map("listing_draft_status")
}

/**
 * New listing being prepared in the ERP (canonical model), published to one account.
 */
model ListingDraft {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  marketplaceAccountId String             @map("marketplace_account_id") @db.Uuid
  /// ERP SKU the listing sells (linked automatically after publishing)
  skuId                String?            @map("sku_id") @db.Uuid
  status               ListingDraftStatus @default(draft)
  /// CanonicalListing (src/domain/listings/canonical.ts)
  content              Json
  /// Messages of the last refused validate/publish (pt-BR when translated)
  lastErrors           String[]           @default([]) @map("last_errors")
  /// Listing created from it (local copy and marketplace id)
  listingId            String?            @map("listing_id") @db.Uuid
  externalId           String?            @map("external_id")
  publishedAt          DateTime?          @map("published_at") @db.Timestamptz(6)
  /// Where the copy came from (reference only: copies are independent)
  sourceKind           ListingSourceKind? @map("source_kind")
  sourceExternalId     String?            @map("source_external_id")
  /// Own account of the source listing (null for other sellers)
  sourceAccountId      String?            @map("source_account_id") @db.Uuid
  /// Batch (sync_jobs replicate_listings) that created it
  batchJobId           String?            @map("batch_job_id") @db.Uuid
  createdById          String?            @map("created_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      MarketplaceAccount @relation(fields: [organizationId, marketplaceAccountId], references: [organizationId, id], onDelete: NoAction)
  sku          Sku?               @relation(fields: [organizationId, skuId], references: [organizationId, id], onDelete: NoAction)
  listing      Listing?           @relation(fields: [organizationId, listingId], references: [organizationId, id], onDelete: NoAction)
  createdBy    Profile?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  batchJob     SyncJob?           @relation(fields: [organizationId, batchJobId], references: [organizationId, id], onDelete: NoAction)

  /// A batch never copies the same source twice (running it again does not duplicate)
  @@unique([batchJobId, sourceExternalId])
  @@index([organizationId, status, updatedAt])
  @@map("listing_drafts")
}

enum ListingSourceKind {
  /// A listing of one of the organization's accounts
  own
  /// Another seller's listing ("copiar de fora")
  external

  @@map("listing_source_kind")
}
