    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-pt-br": "^4.1.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.6",
    "eslint": "^9",
