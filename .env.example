# Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). Server only. Never expose it.
SUPABASE_SECRET_KEY=

# Database: Dashboard > "Connect" button
# Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL=
# Session pooler or direct connection (port 5432). Used by Prisma migrations.
DIRECT_URL=

# App
# Base URL used in e-mail links (confirmation, password reset). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Open sign-up. Keep "false" in production (access by invitation). Only "true" enables it.
ALLOW_PUBLIC_SIGNUP=false

# Marketplace tokens encryption: base64 of 32 random bytes. MUST be the same in
# every environment that shares the database (local .env and Vercel).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Mercado Livre application (developers.mercadolivre.com.br > Minhas aplicações)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Exactly as registered in the application, e.g. https://SEU-DOMINIO/contas/mercadolivre/retorno
ML_REDIRECT_URI=
